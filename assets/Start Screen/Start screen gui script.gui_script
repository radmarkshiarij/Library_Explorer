local PAUSE_FRAME = 84
local TOTAL_FRAMES = 185

function init(self)
	self.book = gui.get_node("Flip")
	self.start_text = gui.get_node("Start button text")
	self.title_text = gui.get_node("Library Explorer title")

	gui.set_alpha(self.start_text, 0)
	gui.set_alpha(self.title_text, 0)

	self.pause_cursor = PAUSE_FRAME / TOTAL_FRAMES
	self.paused = false
	self.resumed = false

	gui.play_flipbook(self.book, "Flip")

	msg.post(".", "acquire_input_focus")
end

function update(self, dt)
	if not self.paused then
		local cursor = gui.get_flipbook_cursor(self.book)
		if cursor >= self.pause_cursor then
			gui.cancel_flipbook(self.book)
			gui.set_flipbook_cursor(self.book, self.pause_cursor)
			self.paused = true
			gui.animate(self.start_text, "color.w", 1, gui.EASING_INOUTQUAD, 0.5)
			gui.animate(self.title_text, "color.w", 1, gui.EASING_INOUTQUAD, 0.5)
		end
	end
end

local function on_texts_faded_out(self, node)
	gui.play_flipbook(self.book, "Flip", function(self, node)
		msg.post(msg.url(nil, "main_loader", "main_proxy.collectionproxy"), "load")
	end, { offset = self.pause_cursor })
end

function on_input(self, action_id, action)
	if self.paused and not self.resumed and action_id == hash("touch") and action.pressed then
		if gui.pick_node(self.start_text, action.x, action.y) then
			self.resumed = true
			gui.animate(self.start_text, "color.w", 0, gui.EASING_INOUTQUAD, 0.4)
			gui.animate(self.title_text, "color.w", 0, gui.EASING_INOUTQUAD, 0.4, 0, on_texts_faded_out)
		end
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("proxy_loaded") then
		msg.post(sender, "init")
		msg.post(sender, "enable")
		msg.post(sender, "acquire_input_focus")
		msg.post(".", "release_input_focus")
		msg.post("#", "disable")
	end
end